# Copy to .env (gitignored, never committed) and fill in real values.
# Keys must match what backend/src/config/env.validation.ts requires and what
# app.module.ts actually reads — see backend/README.md and the root CLAUDE.md.

# --- Database (required) ---
# Azure Database for PostgreSQL by default (docker-compose.yml). Overridden to
# a local container's values by docker-compose.local.yml (DB_HOST=db, DB_SSL=false).
DB_HOST=pg-havit-dev-01.postgres.database.azure.com
DB_PORT=5432
DB_USERNAME=user
DB_PASSWORD=password
DB_DATABASE=havit
DB_SSL=true

# --- PgBouncer (optional — B1 connection pooling) ---
# docker-compose.yml always starts a `pgbouncer` container pointed at
# DB_HOST/DB_USERNAME/DB_PASSWORD/DB_DATABASE above; `backend` only routes
# through it when both of these are set (pointing at the compose service).
# Unset = old direct-to-Postgres behavior. See backend/performance/B1-PGBOUNCER.md.
# DB_POOL_HOST=pgbouncer
# DB_POOL_PORT=6432
# DB_POOL_SIZE=10

# --- Auth (required) ---
JWT_SECRET=change-me

# --- Redis (optional — B6 read-through cache) ---
# Unset or unreachable Redis never breaks the API: RedisCacheService
# (backend/src/cache/redis-cache.service.ts) fails open and falls back to
# Postgres. docker-compose.yml already defaults this to redis://redis:6379
# (the `redis` service it starts) if left unset here — only set it to point
# at something else (e.g. Azure Cache for Redis: rediss://<name>.redis.cache.windows.net:6380).
# See backend/performance/REDIS.md for the full local/production story.
# REDIS_URL=redis://redis:6379

# --- Optional integrations (safe to leave unset for local dev) ---
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET_NAME=
# CLOUDFLARE_R2_PUBLIC_URL=
# OPENAI_API_KEY=

# --- Push notifications (optional — B3) ---
# The backend sends pushes through Expo's push service; it works without any
# key. Set this only if "Enhanced push security" is enabled in the Expo
# account (expo.dev > project > Credentials). See backend/docs/notificaciones/B3-NOTIFICACIONES.md.
# EXPO_ACCESS_TOKEN=
